{
  "name": "@rnine/nineos",
  "version": "0.1.0",
  "license": "MIT",
  "description": "NineOS: a design system library with two moods (Clear and Cipher), cut corners, a command-line-plus-panels shell and its motion layer. Built on @rnine/core",
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "ui",
    "scss",
    "nineos",
    "cli",
    "terminal"
  ],
  "homepage": "https://ui.rnine.dev",
  "bugs": {
    "url": "https://github.com/rNineTheFirst/rnine-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rNineTheFirst/rnine-ui.git",
    "directory": "packages/nineos"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./fonts.css",
    "./scss": {
      "sass": "./scss/_index.scss",
      "default": "./scss/_index.scss"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./theme.json": "./theme.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scss",
    "tokens",
    "fonts.css",
    "theme.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs && vite build && tsc -p tsconfig.build.json && node scripts/build.mjs --bundle",
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "lint": "eslint .",
    "test": "vitest run && node --test \"test/**/*.test.mjs\"",
    "clean": "rimraf dist storybook-static node_modules"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.80.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "dependencies": {
    "@rnine/core": "0.1.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "sass": "1.106.1",
    "storybook": "10.6.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
