{
  "$description": "NineOS primitive colors (accent and signal are the default Magenta palette; tokens/palettes/ swaps them). Never use these directly in components: use the semantic roles in themes/*.json.",
  "color": {
    "$type": "color",
    "gray": {
      "0": { "$value": "#FFFFFF" },
      "10": { "$value": "#F4F4F6" },
      "25": { "$value": "#F5F5F7" },
      "50": { "$value": "#EDEDF1" },
      "100": { "$value": "#DBDBE1" },
      "300": { "$value": "#A2A2AD" },
      "500": { "$value": "#6E6F7A" },
      "600": { "$value": "#4E4F57" },
      "800": { "$value": "#26262C" },
      "850": { "$value": "#18181C" },
      "900": { "$value": "#111114" },
      "950": { "$value": "#0A0A0C" },
      "975": { "$value": "#050506" }
    },
    "accent": {
      "300": { "$value": "#FF4FB0" },
      "400": { "$value": "#FF1F9A" },
      "500": { "$value": "#E6007E" },
      "600": { "$value": "#D4006F" },
      "700": { "$value": "#C20066" },
      "800": { "$value": "#9E0052" }
    },
    "signal": {
      "300": { "$value": "#1FE0FF" },
