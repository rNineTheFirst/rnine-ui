      "700": { "$value": "#00779C" }
    },
    "green": {
      "400": { "$value": "#3DDC84" },
      "700": { "$value": "#14804A" }
    },
    "amber": {
      "400": { "$value": "#FFB020" },
      "700": { "$value": "#9A5B00" }
    },
    "red": {
      "400": { "$value": "#FF6B4A" },
      "700": { "$value": "#C2361A" }
    }
  }
}
