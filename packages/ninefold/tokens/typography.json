{
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Fraunces Variable",
        "Fraunces",
        "Georgia",
        "serif"
      ],
      "$description": "Headings, the shop’s name, numbers that matter (soft, wonky Fraunces)"
    },
    "body": {
      "$value": [
        "Literata Variable",
        "Literata",
        "Georgia",
        "serif"
      ],
      "$description": "Running text and UI"
    },
    "mono": {
      "$value": [
        "Courier Prime",
        "Courier New",
        "monospace"
      ],
      "$description": "Labels, eyebrows, dates: the typewriter"
    },
    "script": {
      "$value": [
        "Pinyon Script",
        "Segoe Script",
        "cursive"
      ],
      "$description": "Signatures and the odd flourish, never running text"
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": {
      "$value": "0.75rem"
    },
    "sm": {
      "$value": "0.875rem"
    },
    "base": {
      "$value": "1rem"
    },
    "md": {
      "$value": "1.125rem"
    },
    "lg": {
      "$value": "1.25rem"
    },
    "xl": {
      "$value": "1.5rem"
    },
    "2xl": {
      "$value": "2rem"
    },
    "3xl": {
      "$value": "2.5rem"
    },
    "4xl": {
      "$value": "3.25rem"
    },
    "5xl": {
      "$value": "4.5rem"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 1.06
    },
    "snug": {
      "$value": 1.25
    },
    "normal": {
      "$value": 1.6
    }
  },
  "tracking": {
    "$type": "dimension",
    "tight": {
      "$value": "-0.01em"
    },
    "normal": {
      "$value": "0em"
    },
    "wide": {
      "$value": "0.06em"
    },
    "wider": {
      "$value": "0.1em"
    },
    "mark": {
      "$value": "0.2em",
      "$description": "Wordmarks only"
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Type roles. Use these, not raw sizes. Display sizes are fluid between 400px and 1200px wide.",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "clamp(2.5rem, 1.25rem + 4.6vw, 4.25rem)",
        "lineHeight": 1.04,
        "letterSpacing": "-0.012em"
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "clamp(2rem, 1.3rem + 2.8vw, 3.25rem)",
        "lineHeight": 1.06,
        "letterSpacing": "-0.01em"
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "clamp(1.625rem, 1.25rem + 1.5vw, 2.375rem)",
        "lineHeight": 1.12,
        "letterSpacing": "0em"
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "1.4375rem",
        "lineHeight": 1.15,
        "letterSpacing": "0em"
      }
    },
    "h4": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "1.1875rem",
        "lineHeight": 1.2,
        "letterSpacing": "0em"
      }
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": "1.125rem",
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": "1rem",
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": "0.875rem",
        "lineHeight": 1.55,
        "letterSpacing": "0em"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": "0.78125rem",
        "lineHeight": 1.25,
        "letterSpacing": "0.13em"
      },
      "$description": "Uppercase typewriter eyebrows, chips, table heads"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": "0.9375rem",
        "lineHeight": 1.7,
        "letterSpacing": "0em"
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": "0.75rem",
        "lineHeight": 1.4,
        "letterSpacing": "0.06em"
      }
    },
    "wordmark": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "0.875rem",
        "lineHeight": 1,
        "letterSpacing": "0.2em"
      }
    }
  }
}
