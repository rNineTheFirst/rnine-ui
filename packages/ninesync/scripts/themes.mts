// Writes tokens/themes/*.json: syncColors() for the default client colors
// (src/client/syncColors.ts), with each role's description. Run after
// changing syncColors or SYNC_BASE:  node scripts/themes.mts
// (test/contrast.test.mjs checks the built tokens still match.)
import { readFileSync, writeFileSync } from 'node:fs';
import { syncColors } from '../src/client/syncColors.ts';

const at = (path: string) => new URL(path, import.meta.url);
const core = JSON.parse(readFileSync(at('../../core/tokens/themes/light.json'), 'utf8')).theme;
const OWN: Record<string, string> = {
  'fg-strong': 'Headings, figures and the selected item: the strongest text',
  mark: 'The pale mark under titles, tabs and links, and the sheen, wash and toast timer. Decoration, never text',
  'mark-strong': 'Spinners and marks that need a little more weight',
  'mark-line': 'Outlined buttons’ border',
  'mark-soft': 'Field focus ring and soft highlights',
  glow: 'The hover glow, inner layers',
  'glow-faint': 'The hover glow, outer layer',
};
const ABOUT = {
  light: 'Light: NineSync’s light mood. Greys tinted toward the client’s hue (the Sync blue by default), white cards. Generated by scripts/themes.mts from syncColors().',
  dark: 'Dark: NineSync’s dark mood. The same roles on near-black; the Sync light blue is the dark mood’s second color. Generated by scripts/themes.mts from syncColors().',
};

const result = syncColors();
for (const scheme of ['light', 'dark'] as const) {
  const theme: Record<string, unknown> = { $type: 'color' };
  for (const [name, value] of Object.entries(result[scheme].roles)) {
    theme[name] = { $value: value, $description: OWN[name] ?? core[name]?.$description ?? name };
  }
  writeFileSync(at(`../tokens/themes/${scheme}.json`), `${JSON.stringify({ $description: ABOUT[scheme], theme }, null, 2)}\n`);
}
console.log('NineSync: tokens/themes/light.json, dark.json');
