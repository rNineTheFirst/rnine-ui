{
  "name": "@rnine/core",
  "version": "0.1.1",
  "license": "MIT",
  "description": "The shared core of the @rnine design system libraries: mood and motion engine, the components every library has (in a plain placeholder look), the shared SCSS API and the token build tool",
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "ui",
    "scss",
    "plain",
    "design-tokens"
  ],
  "homepage": "https://ui.rnine.dev",
  "bugs": {
    "url": "https://github.com/rNineTheFirst/rnine-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rNineTheFirst/rnine-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./fonts.css",
    "./scss": {
      "sass": "./scss/_index.scss",
      "default": "./scss/_index.scss"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./build-tokens": "./scripts/build-tokens.mjs",
    "./conformance": "./scripts/conformance.mjs",
    "./theme.json": "./theme.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scss",
    "tokens",
    "scripts/build-tokens.mjs",
    "scripts/conformance.mjs",
    "fonts.css",
    "theme.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs && vite build && tsc -p tsconfig.build.json && node scripts/build.mjs --bundle",
    "lint": "eslint .",
    "test": "vitest run && node --test \"test/**/*.test.mjs\"",
    "clean": "rimraf dist node_modules"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.80.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "3.2.6",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "sass": "1.106.1",
    "simple-icons": "16.36.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
